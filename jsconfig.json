{
  "compilerOptions": {
    "checkJs": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "strict": true,
    "noEmit": true
  },
  "include": [
    "packages/**/*.js",
    "apps/**/*.js",
    "tests/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
